# Copy to .env for local development (never commit the real .env file).

# Core Django settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave unset locally to use sqlite3; Render provides this automatically)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Cookie / HTTPS hardening (enable these once the app is served over HTTPS)
DJANGO_SECURE_COOKIES=0
DJANGO_FORCE_HTTPS=0
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
DJANGO_CSRF_TRUSTED_ORIGINS=

# LLM providers used for the AI check-in summary
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email (defaults to console backend when DEBUG is on)
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USERNAME=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
